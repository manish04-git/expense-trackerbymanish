# Firebase web config (Project settings > Your apps > Web app).
# These values are NOT secrets; data is protected by Auth + Security Rules + App Check.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional (Analytics)
VITE_FIREBASE_MEASUREMENT_ID=
# Optional (App Check, reCAPTCHA v3 site key)
VITE_APP_CHECK_SITE_KEY=
# Set to true to talk to the local Firebase Emulator Suite
VITE_USE_EMULATORS=false
